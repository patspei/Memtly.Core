@model Memtly.Core.Models.WeddingOptions
<main class="wedding-home">
    <section class="wedding-hero" aria-labelledby="wedding-title">
        <img src="@Model.HeroImage" alt="Ein Moment voller Vorfreude" fetchpriority="high" />
        <div class="wedding-hero-copy">
            <h1 id="wedding-title">Unsere Hochzeit</h1>
        </div>
    </section>
    <section class="wedding-intro" id="erinnerungen">
        <p class="wedding-eyebrow">Die schönsten Momente bleiben</p>
        <h2>Unser Tag. Eure Perspektive.</h2>
        <p>Wie schön, dass ihr Teil unserer Geschichte seid. Hier sammeln wir die großen Gefühle und die kleinen Augenblicke unserer Hochzeit - zum Wiedererleben, Herunterladen und Teilen.</p>
    </section>
    <section class="wedding-cards" aria-label="Unsere Galerien">
        <a class="wedding-card" href="/Wedding/Gallery/professional">
            <div class="wedding-card-photo"><img src="@(string.IsNullOrWhiteSpace(Model.GalleryCardImage) ? Model.HeroImage : Model.GalleryCardImage)" alt="" loading="lazy" /></div>
            <div class="wedding-card-copy"><h3>Unsere Galerie</h3><p>Entdeckt die schönsten Erinnerungen an unseren Hochzeitstag.</p><span>Galerie entdecken ↗</span></div>
        </a>
        <button type="button" class="wedding-card" data-wedding-share>
            <span class="wedding-card-photo"><img src="@(string.IsNullOrWhiteSpace(Model.UploadCardImage) ? Model.HeroImage : Model.UploadCardImage)" alt="" loading="lazy" /></span>
            <span class="wedding-card-copy"><span class="wedding-card-title">Handyfotos hochladen</span><span class="wedding-card-description">Teilt eure Erinnerungen mit allen oder ganz privat mit uns.</span><span class="wedding-card-action">Fotos teilen ↗</span></span>
        </button>
    </section>
</main>
